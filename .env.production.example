# Face Recognition System - production environment template
# Copy to a deployment-specific secret store/environment. Never commit real credentials.

# Core database: PostgreSQL is recommended for multi-tenant production.
DATABASE_URL=postgresql://frs_user:CHANGE_ME@127.0.0.1:5432/frs
# FRS_SQLITE_PATH=backend_face/data/frs.db

# Authentication/bootstrap. Remove bootstrap password after the first successful startup.
FRS_JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
FRS_BOOTSTRAP_ADMIN_USER=superadmin
FRS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_TO_AT_LEAST_12_CHARACTERS
FRS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8005,http://127.0.0.1:8005

# Recognition. Provide your own commercially licensed ArcFace-compatible ONNX model.
# If omitted, the hardened dlib 128-D matcher remains the supported fallback.
# Detection remains permissive for long-distance monitoring; assigning a name and
# attendance is intentionally much stricter so uncertain faces remain Unknown.
FRS_ARCFACE_MODEL_PATH=/opt/frs/models/arcface_512.onnx
FRS_ARCFACE_COSINE_THRESHOLD=0.62
FRS_ARCFACE_DISTANT_COSINE_THRESHOLD=0.68
FRS_ARCFACE_MARGIN=0.10
FACE_DETECTION_MIN_PX=20
FACE_RECOGNITION_MIN_PX=64
FACE_ATTENDANCE_MIN_PX=88
FACE_CONFIRM_FRAMES=4
FACE_CONFIRM_WINDOW=6
FACE_MATCH_DISTANCE=0.42
FACE_DISTANT_MATCH_DISTANCE=0.37
FACE_MATCH_MARGIN=0.07
FACE_NMS_IOU=0.38
FACE_NMS_CONTAINMENT=0.72
FACE_ROBUST_DISTANCE_SLACK=0.008
FACE_MINIMUM_MARGIN_RATIO=0.55
FACE_TRACK_DLIB_ANCHOR_DISTANCE=0.40
FACE_TRACK_ARCFACE_ANCHOR_SIMILARITY=0.68
FACE_MIN_KNOWN_SAVE_CONFIDENCE=0.55
FRS_MIN_ENROLL_FACE_PX=120
FRS_DUPLICATE_FACE_DISTANCE=0.44

# Presentation-attack/liveness model. A validated PAD ONNX model is required for
# production fail-closed anti-spoofing at attendance gates.
FRS_LIVENESS_MODEL_PATH=/opt/frs/models/liveness_pad.onnx
FRS_LIVENESS_REQUIRED=auto
FRS_LIVENESS_THRESHOLD=0.65
FRS_LIVENESS_REAL_CLASS_INDEX=1

# PostgreSQL pgvector is activated automatically when ArcFace 512-D is available.
# The application creates the vector extension/table/index when DB permissions allow it.

# Optional Redis distributed event deduplication / recognition pubsub.
REDIS_URL=redis://127.0.0.1:6379/0
FRS_REDIS_PREFIX=frs
FRS_DISTRIBUTED_EVENT_TTL=5

# Evidence storage: filesystem, s3, or minio.
FRS_EVIDENCE_STORAGE=minio
FRS_S3_BUCKET=frs-evidence
FRS_S3_PREFIX=production
FRS_S3_ENDPOINT_URL=http://127.0.0.1:9000
FRS_S3_REGION=us-east-1
FRS_S3_DELETE_LOCAL=0
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Camera/security defaults.
FRS_ALLOW_PUBLIC_CAMERA_URLS=0
FRS_ENABLE_PUBLIC_BIOMETRIC_STATIC=0
FRS_ENABLE_LEGACY_MATCHING=0
FRS_STREAM_JPEG_QUALITY=86

# Accuracy certification thresholds for a representative benchmark manifest.
FRS_BENCHMARK_MAX_FAR=0.001
FRS_BENCHMARK_MAX_FRR=0.08
FRS_BENCHMARK_MIN_SAMPLES=100
